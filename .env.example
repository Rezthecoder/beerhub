# Copy to .env.local for local development. On Vercel, add each of these under
# Project → Settings → Environment Variables (never commit real values).

# Site address (no trailing slash). Used for payment redirects and webhooks.
NEXT_PUBLIC_BASE_URL=https://beerhub.rezxkaihatsu.com

# Demo mode: shows the demo banner and refuses live Stripe keys. Leave as true for the portfolio demo.
NEXT_PUBLIC_DEMO_MODE=true

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe TEST keys (Dashboard → Developers → API keys, with "Test mode" on)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# PayPay sandbox (PayPay for Developers → sandbox credentials)
PAYPAY_API_KEY=xxx
PAYPAY_SECRET=xxx
PAYPAY_MERCHANT_ID=xxx

# Login for /admin/orders (browser asks for this username and password)
ADMIN_USER=admin
ADMIN_PASSWORD=choose-a-long-password
